        <!-- NOTES -->
        <mxCell id="pn1h" value="NOTE  ·  WAN2 FAILOVER INCIDENT (2026-07-22)" style="text;html=1;fillColor=#F5C518;strokeColor=#B8860B;fontStyle=1;fontSize=11;align=left;verticalAlign=middle;spacingLeft=10;fontColor=#5C4300;" vertex="1" parent="1">
          <mxGeometry x="852" y="216" width="392" height="24" as="geometry" />
        </mxCell>
        <mxCell id="pn1b" value="WAN2 LTE failover is degraded: nic2 was fixed live but &lt;b&gt;NOT persisted&lt;/b&gt; — needs a post-up in vmbr2 to survive reboot. The MR7400 hotspot's Ethernet still isn't serving DHCP. Treat WAN failover as not-yet-reliable until persisted." style="text;html=1;fillColor=#FFFBEA;strokeColor=#B8860B;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;spacingLeft=10;spacingTop=8;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="852" y="240" width="392" height="112" as="geometry" />
        </mxCell>
        <mxCell id="pn2h" value="NOTE  ·  EX3400 NATIVE-VLAN (ELS)" style="text;html=1;fillColor=#F5C518;strokeColor=#B8860B;fontStyle=1;fontSize=11;align=left;verticalAlign=middle;spacingLeft=10;fontColor=#5C4300;" vertex="1" parent="1">
          <mxGeometry x="852" y="364" width="392" height="24" as="geometry" />
        </mxCell>
        <mxCell id="pn2b" value="native-vlan-id is set at &lt;b&gt;interface level&lt;/b&gt; (not under unit 0). Node ports are trunks (native 1 + tagged servers). pve2 vmbr2/nic2 auto-start disabled to avoid a trunk loop; ifreload does not apply bridge-vlan-aware on pve2 — needs a full reboot." style="text;html=1;fillColor=#FFFBEA;strokeColor=#B8860B;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;spacingLeft=10;spacingTop=8;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="852" y="388" width="392" height="120" as="geometry" />
        </mxCell>
        <mxCell id="pn3h" value="NOTE  ·  ARES MGMT PATH + COROSYNC" style="text;html=1;fillColor=#F5C518;strokeColor=#B8860B;fontStyle=1;fontSize=11;align=left;verticalAlign=middle;spacingLeft=10;fontColor=#5C4300;" vertex="1" parent="1">
          <mxGeometry x="852" y="520" width="392" height="24" as="geometry" />
        </mxCell>
        <mxCell id="pn3b" value="Keep Ares' wired leg enp0s31f6 (.100) connected during any pve2/OPNsense maintenance — it is authoritative. Ares also carries enp0s31f6.20 (.20.199) as the VLAN 20 OOB/BMC jump host. Corosync ring stays on stable VLAN 1 L2 — never move it to VLAN 30." style="text;html=1;fillColor=#FFFBEA;strokeColor=#B8860B;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;spacingLeft=10;spacingTop=8;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="852" y="544" width="392" height="130" as="geometry" />
        </mxCell>

        <mxCell id="p_legend" value="Amber dashed = LTE failover path   ·   xe-* = 10G, ge-* = 1G   ·   Source: Home-Lab/CLAUDE.md (2026-07-23)" style="text;html=1;fillColor=none;strokeColor=none;fontSize=10;align=left;verticalAlign=middle;fontColor=#7A6A2A;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="852" y="682" width="392" height="34" as="geometry" />
        </mxCell>


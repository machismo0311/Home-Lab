        <mxCell id="aG2h" value="REVERSE PROXY  —  nginx-proxy-manager (NPM)" style="text;html=1;fillColor=#6C8EBF;strokeColor=#6C8EBF;fontColor=#ffffff;fontStyle=1;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1">

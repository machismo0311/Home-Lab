        <mxCell id="a2p3" value="&lt;b&gt;chat.netframe.local&lt;/b&gt;  →  Open WebUI (.185)  →  llm_router backend" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#F4F8FD;strokeColor=#6C8EBF;align=left;verticalAlign=middle;fontSize=10;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="98" y="494" width="530" height="34" as="geometry" />

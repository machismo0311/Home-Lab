        <mxCell id="a2p2b" value="host id 5" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6C8EBF;fontFamily=monospace;fontSize=10;align=center;" vertex="1" parent="1">

        <mxCell id="v70p" value="Sandbox / lab experiments — standalone 'sandbox' EliteDesk (.70.x). NOT a km-cluster member." style="text;html=1;fillColor=none;strokeColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="156" y="734" width="466" height="42" as="geometry" />
        </mxCell>

        <!-- ============ Bottom gateway strip ============ -->
        <mxCell id="v_gw" value="&lt;b&gt;L3 gateway &amp; firewall:&lt;/b&gt; OPNsense VM 100 (pve2) = .1 on every VLAN     ·     &lt;b&gt;Core switch:&lt;/b&gt; EX3400-48P — 192.168.10.50, JunOS 23.4R2-S7.4     ·     Inter-VLAN routing + firewalling on OPNsense" style="text;html=1;fillColor=#FFF3D6;strokeColor=#B8860B;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontColor=#5C4300;" vertex="1" parent="1">
          <mxGeometry x="60" y="796" width="770" height="46" as="geometry" />
        </mxCell>

        <!-- =========================================================== -->
        <!-- NOTES COLUMN                                                -->
        <!-- =========================================================== -->
        <mxCell id="vn1h" value="NOTE  ·  DHCP — KEA on OPNsense" style="text;html=1;fillColor=#F5C518;strokeColor=#B8860B;fontStyle=1;fontSize=11;align=left;verticalAlign=middle;spacingLeft=10;fontColor=#5C4300;" vertex="1" parent="1">
          <mxGeometry x="852" y="132" width="392" height="24" as="geometry" />
        </mxCell>
        <mxCell id="vn1b" value="Backend migrated ISC → Kea 2026-07-20 after an empty-Kea outage. Holds all 12 reservations and hands out &lt;b&gt;both&lt;/b&gt; Pi-hole .177 + .178 on all 7 VLAN scopes → automatic client DNS failover. Resolver = Unbound on .1. Critical services (.177 / .181 / .183 / .148) are static-in-container so a DHCP outage can't drop routing." style="text;html=1;fillColor=#FFFBEA;strokeColor=#B8860B;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;spacingLeft=10;spacingTop=8;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="852" y="156" width="392" height="128" as="geometry" />
        </mxCell>

        <mxCell id="vn2h" value="NOTE  ·  DNS — HIGH AVAILABILITY" style="text;html=1;fillColor=#F5C518;strokeColor=#B8860B;fontStyle=1;fontSize=11;align=left;verticalAlign=middle;spacingLeft=10;fontColor=#5C4300;" vertex="1" parent="1">
          <mxGeometry x="852" y="296" width="392" height="24" as="geometry" />
        </mxCell>
        <mxCell id="vn2b" value="Primary Pi-hole .177 (pve1 LXC 103) + secondary .178 (pve5 CT 108 'netframe-pihole2'). Secondary is a nebula-sync full mirror (systemd /15 min: gravity, adlists, local DNS, allow/deny). Both admin passwords unified in Vaultwarden." style="text;html=1;fillColor=#FFFBEA;strokeColor=#B8860B;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;spacingLeft=10;spacingTop=8;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="852" y="320" width="392" height="100" as="geometry" />
        </mxCell>

        <mxCell id="vn3h" value="NOTE  ·  EX3400 — TRUNK / NATIVE-VLAN GOTCHA" style="text;html=1;fillColor=#F5C518;strokeColor=#B8860B;fontStyle=1;fontSize=11;align=left;verticalAlign=middle;spacingLeft=10;fontColor=#5C4300;" vertex="1" parent="1">
          <mxGeometry x="852" y="432" width="392" height="24" as="geometry" />
        </mxCell>
        <mxCell id="vn3b" value="On this EX3400 (ELS) native-vlan-id goes at &lt;b&gt;interface level&lt;/b&gt;, NOT under unit 0 family ethernet-switching. Node ports are trunks (native 1 + tagged servers). pve2 vmbr2/nic2 auto-start is DISABLED — a live UniFi cable on that unused bridge caused a trunk loop." style="text;html=1;fillColor=#FFFBEA;strokeColor=#B8860B;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;spacingLeft=10;spacingTop=8;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="852" y="456" width="392" height="120" as="geometry" />
        </mxCell>

        <mxCell id="vn4h" value="NOTE  ·  SECURITY SEGMENTATION (Phase 1)" style="text;html=1;fillColor=#F5C518;strokeColor=#B8860B;fontStyle=1;fontSize=11;align=left;verticalAlign=middle;spacingLeft=10;fontColor=#5C4300;" vertex="1" parent="1">
          <mxGeometry x="852" y="588" width="392" height="24" as="geometry" />
        </mxCell>
        <mxCell id="vn4b" value="All three BMCs moved off flat VLAN 1 onto VLAN 20 (2026-07-03); factory creds rotated → Vaultwarden. Ports ge-0/0/30 · 32 · 44 are tagged-VLAN-20-only. Pending: OPNsense rule to deny non-Ares → VLAN 20 and block BMC internet egress (Phase 1.5)." style="text;html=1;fillColor=#FFFBEA;strokeColor=#B8860B;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;spacingLeft=10;spacingTop=8;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="852" y="612" width="392" height="118" as="geometry" />
        </mxCell>

        <mxCell id="v_legend" value="Chip colour = security tier   ·   Subnet badges are /24   ·   Source: Home-Lab/CLAUDE.md (2026-07-23)" style="text;html=1;fillColor=none;strokeColor=none;fontSize=10;align=left;verticalAlign=middle;fontColor=#7A6A2A;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="852" y="742" width="392" height="60" as="geometry" />
        </mxCell>


        <!-- ============ G2 REVERSE PROXY - NPM (blue) ============ -->
        <mxCell id="aG2" value="" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#E1EAF7;strokeColor=#6C8EBF;verticalAlign=top;" vertex="1" parent="1">

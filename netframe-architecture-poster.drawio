        <mxCell id="a2p2" value="&lt;b&gt;llm.netframe.local&lt;/b&gt;  →  Jarvis llm_router (.31:8000)  ·  HTTP-only" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#F4F8FD;strokeColor=#6C8EBF;align=left;verticalAlign=middle;fontSize=10;spacingLeft=10;" vertex="1" parent="1">

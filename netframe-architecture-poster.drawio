        <mxCell id="a2p3b" value="host id 6" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6C8EBF;fontFamily=monospace;fontSize=10;align=center;" vertex="1" parent="1">
          <mxGeometry x="648" y="494" width="166" height="34" as="geometry" />
        </mxCell>
        <mxCell id="a2note" value="TLS: public names via Let's Encrypt (Cloudflare DNS-01); internal *.netframe.local via step-ca. :3000/:8000 backends firewalled to NPM only." style="text;html=1;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=10;fontStyle=2;spacingLeft=10;fontColor=#3B5A86;" vertex="1" parent="1">
          <mxGeometry x="98" y="532" width="716" height="32" as="geometry" />
        </mxCell>

        <!-- ============ G3 SPLIT DNS (green) ============ -->
        <mxCell id="aG3" value="" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#E3F0DE;strokeColor=#82B366;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="60" y="588" width="770" height="216" as="geometry" />
        </mxCell>
        <mxCell id="aG3h" value="SPLIT DNS  —  Pi-hole (HA) + Unbound" style="text;html=1;fillColor=#82B366;strokeColor=#82B366;fontColor=#ffffff;fontStyle=1;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="60" y="588" width="770" height="26" as="geometry" />
        </mxCell>
        <mxCell id="a3i1" value="" style="sketch=0;html=1;shape=mxgraph.networks.server;fillColor=#82B366;strokeColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="78" y="624" width="40" height="42" as="geometry" />
        </mxCell>
        <mxCell id="a3t1" value="&lt;b&gt;Pi-hole DNS&lt;/b&gt; · primary .177 (pve1) + secondary .178 (pve5 CT 108). OPNsense/Kea hands out BOTH on all 7 scopes → client failover." style="text;html=1;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="128" y="622" width="480" height="46" as="geometry" />
        </mxCell>
        <mxCell id="a3b1" value=".177 / .178" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82B366;fontFamily=monospace;fontSize=10;align=center;" vertex="1" parent="1">
          <mxGeometry x="628" y="630" width="186" height="28" as="geometry" />
        </mxCell>
        <mxCell id="a3i2" value="" style="sketch=0;html=1;shape=mxgraph.networks.router;fillColor=#82B366;strokeColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="78" y="682" width="42" height="40" as="geometry" />
        </mxCell>
        <mxCell id="a3t2" value="&lt;b&gt;Unbound&lt;/b&gt; recursive resolver on OPNsense (.1) — Pi-hole's upstream; performs the recursive lookups for external names." style="text;html=1;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="128" y="680" width="480" height="46" as="geometry" />
        </mxCell>
        <mxCell id="a3b2" value="192.168.10.1" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82B366;fontFamily=monospace;fontSize=10;align=center;" vertex="1" parent="1">
          <mxGeometry x="628" y="688" width="186" height="28" as="geometry" />
        </mxCell>
        <mxCell id="a3t3" value="&lt;b&gt;Local records (split-horizon):&lt;/b&gt; llm · chat · homepage · homeassistant.netframe.local + *.netframe.local → internal IPs. Resolve only for Pi-hole clients; public kylemason.org names resolve everywhere but proxy internally." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F1F8ED;strokeColor=#82B366;align=left;verticalAlign=middle;fontSize=10;spacingLeft=10;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="98" y="732" width="716" height="58" as="geometry" />
        </mxCell>

        <!-- ============ NOTES COLUMN ============ -->
        <mxCell id="an1h" value="NOTE  ·  SPLIT-HORIZON DNS" style="text;html=1;fillColor=#F5C518;strokeColor=#B8860B;fontStyle=1;fontSize=11;align=left;verticalAlign=middle;spacingLeft=10;fontColor=#5C4300;" vertex="1" parent="1">
          <mxGeometry x="852" y="100" width="392" height="24" as="geometry" />
        </mxCell>
        <mxCell id="an1b" value="&lt;b&gt;netframe.local&lt;/b&gt; names exist only on Pi-hole → resolve for LAN/VPN clients, never publicly. &lt;b&gt;kylemason.org&lt;/b&gt; names are public DNS but NPM proxies them to internal services. A device not using Pi-hole (.177/.178) can't reach the *.netframe.local vhosts." style="text;html=1;fillColor=#FFFBEA;strokeColor=#B8860B;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;spacingLeft=10;spacingTop=8;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="852" y="124" width="392" height="132" as="geometry" />
        </mxCell>

        <mxCell id="an2h" value="NOTE  ·  NPM ADMIN LOCKDOWN" style="text;html=1;fillColor=#F5C518;strokeColor=#B8860B;fontStyle=1;fontSize=11;align=left;verticalAlign=middle;spacingLeft=10;fontColor=#5C4300;" vertex="1" parent="1">
          <mxGeometry x="852" y="268" width="392" height="24" as="geometry" />
        </mxCell>
        <mxCell id="an2b" value="NPM admin UI :81 is restricted to Ares (.199) via a DOCKER-USER firewall rule (finding F-05). Backends like Homepage :3000 and llm_router :8000 are firewalled so only NPM can reach them." style="text;html=1;fillColor=#FFFBEA;strokeColor=#B8860B;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;spacingLeft=10;spacingTop=8;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="852" y="292" width="392" height="108" as="geometry" />
        </mxCell>

        <mxCell id="an3h" value="NOTE  ·  HEADSCALE (VPN) — PHASE 2 PENDING" style="text;html=1;fillColor=#F5C518;strokeColor=#B8860B;fontStyle=1;fontSize=11;align=left;verticalAlign=middle;spacingLeft=10;fontColor=#5C4300;" vertex="1" parent="1">
          <mxGeometry x="852" y="412" width="392" height="24" as="geometry" />
        </mxCell>
        <mxCell id="an3b" value="Self-hosted Tailscale control plane on pve5 (moved 2026-07-16). Current mesh: Ares (.1), Randy (.2), pve5 (.3), pve4 (.4), pve3 (.5), Jarvis (.6). Phase 2: QuarkyLab + the researcher's Mac must migrate together — do not migrate one alone." style="text;html=1;fillColor=#FFFBEA;strokeColor=#B8860B;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;spacingLeft=10;spacingTop=8;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="852" y="436" width="392" height="128" as="geometry" />
        </mxCell>

        <mxCell id="an4h" value="NOTE  ·  SECURITY MONITORING (SIEM)" style="text;html=1;fillColor=#F5C518;strokeColor=#B8860B;fontStyle=1;fontSize=11;align=left;verticalAlign=middle;spacingLeft=10;fontColor=#5C4300;" vertex="1" parent="1">
          <mxGeometry x="852" y="576" width="392" height="24" as="geometry" />
        </mxCell>
        <mxCell id="an4b" value="&lt;b&gt;Wazuh&lt;/b&gt; SIEM runs as VM 104 on QuarkyLab (192.168.10.184, dashboard https://…184). qemu-guest-agent enabled → clean host-reboot shutdowns. Migrated off pve2." style="text;html=1;fillColor=#FFFBEA;strokeColor=#B8860B;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;spacingLeft=10;spacingTop=8;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="852" y="600" width="392" height="104" as="geometry" />
        </mxCell>

        <mxCell id="a_legend" value="Reverse-proxy vhosts terminate TLS at NPM   ·   split-horizon = internal names Pi-hole-only   ·   Source: Home-Lab/CLAUDE.md (2026-07-23)" style="text;html=1;fillColor=none;strokeColor=none;fontSize=10;align=left;verticalAlign=middle;fontColor=#7A6A2A;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="852" y="716" width="392" height="80" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>

        <mxCell id="a2t1" value="&lt;b&gt;NPM&lt;/b&gt; (LXC 101, pve3) — reverse proxy + TLS termination. Admin :81 restricted to Ares (.199) via DOCKER-USER firewall. LE certs via Cloudflare DNS-01." style="text;html=1;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="128" y="352" width="480" height="52" as="geometry" />
        </mxCell>
        <mxCell id="a2b1" value="192.168.10.181&#10;admin :81" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6C8EBF;fontFamily=monospace;fontSize=10;align=center;" vertex="1" parent="1">
          <mxGeometry x="628" y="356" width="186" height="42" as="geometry" />
        </mxCell>
        <mxCell id="a2p1" value="&lt;b&gt;homepage.kylemason.org&lt;/b&gt;  →  Homepage (.148)  ·  LE (Cloudflare DNS-01) + basic auth (kyle)" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#F4F8FD;strokeColor=#6C8EBF;align=left;verticalAlign=middle;fontSize=10;spacingLeft=10;" vertex="1" parent="1">

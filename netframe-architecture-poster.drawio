        <!-- =========================================================== -->
        <mxCell id="n1h" value="NOTE  ·  GPU KERNEL PIN" style="text;html=1;fillColor=#F5C518;strokeColor=#B8860B;fontStyle=1;fontSize=11;align=left;verticalAlign=middle;spacingLeft=10;fontColor=#5C4300;" vertex="1" parent="1">
          <mxGeometry x="852" y="100" width="392" height="24" as="geometry" />
        </mxCell>
        <mxCell id="n1b" value="QuarkyLab &amp; Jarvis are pinned to kernel &lt;b&gt;6.14.11-9-pve&lt;/b&gt; (GRUB_DEFAULT) for the NVIDIA 550.163.01 stack. Kernel 6.17+ breaks NVIDIA 550 — never upgrade the kernel or change the GRUB default on either R730." style="text;html=1;fillColor=#FFFBEA;strokeColor=#B8860B;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;spacingLeft=10;spacingTop=8;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="852" y="124" width="392" height="92" as="geometry" />
        </mxCell>

        <mxCell id="n2h" value="NOTE  ·  DUAL-HOMED (VLAN 30)" style="text;html=1;fillColor=#F5C518;strokeColor=#B8860B;fontStyle=1;fontSize=11;align=left;verticalAlign=middle;spacingLeft=10;fontColor=#5C4300;" vertex="1" parent="1">
          <mxGeometry x="852" y="232" width="392" height="24" as="geometry" />
        </mxCell>
        <mxCell id="n2b" value="QuarkyLab / Jarvis / Randy dual-homed since 2026-07-02: corosync + mgmt + monitoring stay on &lt;b&gt;VLAN 1&lt;/b&gt; (.10.x); NFS, PBS backup and internet egress ride &lt;b&gt;Servers VLAN 30&lt;/b&gt; (.30.x, gw .30.1). Corosync deliberately left on VLAN 1." style="text;html=1;fillColor=#FFFBEA;strokeColor=#B8860B;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;spacingLeft=10;spacingTop=8;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="852" y="256" width="392" height="96" as="geometry" />
        </mxCell>

        <mxCell id="n3h" value="NOTE  ·  RANDY — TWO STORAGE CONTROLLERS" style="text;html=1;fillColor=#F5C518;strokeColor=#B8860B;fontStyle=1;fontSize=11;align=left;verticalAlign=middle;spacingLeft=10;fontColor=#5C4300;" vertex="1" parent="1">
          <mxGeometry x="852" y="368" width="392" height="24" as="geometry" />
        </mxCell>
        <mxCell id="n3b" value="Boot = RAID-1 on &lt;b&gt;AVAGO 3108 MegaRAID&lt;/b&gt; (do not reconfigure). Data / JBOD = separate &lt;b&gt;LSI 9207-8e&lt;/b&gt; in IT mode. JBOD may reset on reboot — re-run storcli64 set jbod=on. Original 3108 PCIe slot is DEAD; do not reuse." style="text;html=1;fillColor=#FFFBEA;strokeColor=#B8860B;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;spacingLeft=10;spacingTop=8;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="852" y="392" width="392" height="96" as="geometry" />
        </mxCell>

        <mxCell id="n4h" value="NOTE  ·  SERVICE PLACEMENT (2026-07-16 AAR)" style="text;html=1;fillColor=#F5C518;strokeColor=#B8860B;fontStyle=1;fontSize=11;align=left;verticalAlign=middle;spacingLeft=10;fontColor=#5C4300;" vertex="1" parent="1">
          <mxGeometry x="852" y="504" width="392" height="24" as="geometry" />
        </mxCell>
        <mxCell id="n4b" value="De-concentrated off pve3: &lt;b&gt;pve3&lt;/b&gt; = NPM 101 + Vaultwarden 102 + Homepage 106 + OpenWebUI 107 (VLAN30-pinned). &lt;b&gt;Grafana 103 = pve4&lt;/b&gt;. &lt;b&gt;Headscale 105 = pve5&lt;/b&gt;. DNS is HA: Pi-hole .177 (pve1) + .178 (pve5 CT 108). All services onboot=1." style="text;html=1;fillColor=#FFFBEA;strokeColor=#B8860B;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;spacingLeft=10;spacingTop=8;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="852" y="528" width="392" height="104" as="geometry" />
        </mxCell>

        <mxCell id="n5h" value="NOTE  ·  POWER" style="text;html=1;fillColor=#F5C518;strokeColor=#B8860B;fontStyle=1;fontSize=11;align=left;verticalAlign=middle;spacingLeft=10;fontColor=#5C4300;" vertex="1" parent="1">
          <mxGeometry x="852" y="648" width="392" height="24" as="geometry" />
        </mxCell>
        <mxCell id="n5b" value="&lt;b&gt;Middle Atlantic UPS-OL2200R&lt;/b&gt; feeds the R730s, Randy &amp; DS4246. &lt;b&gt;Tripp Lite SMART1500VA&lt;/b&gt; feeds the EX3400, UniFi &amp; small compute. APC AP7901 managed PDU on EX3400 ge-0/0/38." style="text;html=1;fillColor=#FFFBEA;strokeColor=#B8860B;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;spacingLeft=10;spacingTop=8;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="852" y="672" width="392" height="80" as="geometry" />
        </mxCell>


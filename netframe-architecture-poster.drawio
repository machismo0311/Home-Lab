        <mxCell id="eb_pve1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;strokeColor=#4D6FA9;strokeWidth=2;exitX=0.953;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;" edge="1" parent="1" source="t_sw" target="h_pve1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ===================== NOTES ROW ===================== -->
        <mxCell id="tn1h" value="NOTE  ·  DUAL-HOMING (VLAN 1 + VLAN 30)" style="text;html=1;fillColor=#F5C518;strokeColor=#B8860B;fontStyle=1;fontSize=11;align=left;verticalAlign=middle;spacingLeft=10;fontColor=#5C4300;" vertex="1" parent="1">
          <mxGeometry x="90" y="672" width="460" height="24" as="geometry" />
        </mxCell>
        <mxCell id="tn1b" value="QuarkyLab / Jarvis / Randy carry mgmt + corosync + monitoring on VLAN 1 (.10.x) and NFS / PBS / internet egress on Servers VLAN 30 (.30.x, gw .30.1). pve3 is the only EliteDesk with a VLAN 30 trunk (Vaultwarden .30.182)." style="text;html=1;fillColor=#FFFBEA;strokeColor=#B8860B;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;spacingLeft=10;spacingTop=8;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="90" y="696" width="460" height="100" as="geometry" />
        </mxCell>

        <mxCell id="tn2h" value="NOTE  ·  RKE2 K8S OVERLAY" style="text;html=1;fillColor=#F5C518;strokeColor=#B8860B;fontStyle=1;fontSize=11;align=left;verticalAlign=middle;spacingLeft=10;fontColor=#5C4300;" vertex="1" parent="1">
          <mxGeometry x="570" y="672" width="460" height="24" as="geometry" />
        </mxCell>
        <mxCell id="tn2b" value="3-node HA control plane rke2-cp1/2/3 (VMs 201/202/203 on pve3/4/5 · .51/.52/.53) + Randy bare-metal agent. API VIP 192.168.10.54:6443 (kube-vip), MetalLB pool .71–.75, Cilium CNI, NFS StorageClass from Randy." style="text;html=1;fillColor=#FFFBEA;strokeColor=#B8860B;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;spacingLeft=10;spacingTop=8;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="570" y="696" width="460" height="100" as="geometry" />
        </mxCell>

        <mxCell id="tn3h" value="NOTE  ·  DNS IS HIGHLY AVAILABLE" style="text;html=1;fillColor=#F5C518;strokeColor=#B8860B;fontStyle=1;fontSize=11;align=left;verticalAlign=middle;spacingLeft=10;fontColor=#5C4300;" vertex="1" parent="1">
          <mxGeometry x="1050" y="672" width="460" height="24" as="geometry" />
        </mxCell>
        <mxCell id="tn3b" value="Primary Pi-hole .177 (pve1, standalone) + secondary .178 (pve5 CT 108). OPNsense / Kea hands out BOTH on all 7 VLAN scopes → client failover. Resolver = Unbound on .1. Critical services are static-in-container." style="text;html=1;fillColor=#FFFBEA;strokeColor=#B8860B;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;spacingLeft=10;spacingTop=8;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="1050" y="696" width="460" height="100" as="geometry" />
        </mxCell>

        <!-- ===================== LEGEND ===================== -->
        <mxCell id="lg_b" value="" style="rounded=0;html=1;fillColor=#4D6FA9;strokeColor=#4D6FA9;" vertex="1" parent="1">
          <mxGeometry x="90" y="812" width="34" height="6" as="geometry" />
        </mxCell>
        <mxCell id="lg_bt" value="VLAN 1 (mgmt / corosync)" style="text;html=1;fillColor=none;strokeColor=none;fontSize=10;align=left;verticalAlign=middle;fontColor=#333333;" vertex="1" parent="1">

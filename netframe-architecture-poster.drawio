        </mxCell>

        <mxCell id="sn3h" value="NOTE  ·  3-2-1 GAP (R-04)" style="text;html=1;fillColor=#F5C518;strokeColor=#B8860B;fontStyle=1;fontSize=11;align=left;verticalAlign=middle;spacingLeft=10;fontColor=#5C4300;" vertex="1" parent="1">
          <mxGeometry x="852" y="420" width="392" height="24" as="geometry" />
        </mxCell>
        <mxCell id="sn3b" value="Randy is currently the single backup target. A Dell &lt;b&gt;R730xd&lt;/b&gt; is being added as a second PBS target to close the 3-2-1 independent-copy gap." style="text;html=1;fillColor=#FFFBEA;strokeColor=#B8860B;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;spacingLeft=10;spacingTop=8;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="852" y="444" width="392" height="96" as="geometry" />
        </mxCell>

        <mxCell id="sn4h" value="NOTE  ·  DS4246 EXPANSION CHECK" style="text;html=1;fillColor=#F5C518;strokeColor=#B8860B;fontStyle=1;fontSize=11;align=left;verticalAlign=middle;spacingLeft=10;fontColor=#5C4300;" vertex="1" parent="1">
          <mxGeometry x="852" y="552" width="392" height="24" as="geometry" />
        </mxCell>
        <mxCell id="sn4b" value="On any DS4246 drive add, bump &lt;b&gt;backup_verify_ds4246_expected&lt;/b&gt; in the backup-verify role (16 → 22 on the 07-17 expand) or the health check fails on a healthy shelf." style="text;html=1;fillColor=#FFFBEA;strokeColor=#B8860B;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;spacingLeft=10;spacingTop=8;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="852" y="576" width="392" height="96" as="geometry" />
